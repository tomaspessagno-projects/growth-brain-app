# === SysData · variables de entorno ===
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA commitees .env.local (está en .gitignore). En prod, cargá estas vars en Vercel.
#
# ⚠️ REGLA DURA: los tokens de HubSpot y Mixpanel son SOLO LECTURA y van SERVER-SIDE
#    (sin prefijo NEXT_PUBLIC_, nunca expuestos al cliente). Jamás escribir en esas plataformas.

# --- Supabase (estado compartido del equipo — hoy en localStorage, en migración) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service-role (SERVER-SIDE, SECRETA). La usa el cron diario para escribir
#     snapshots/priors (bypassa RLS). NUNCA con NEXT_PUBLIC_. Si falta, el cron corre "en seco". ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron diario (Capa 1). Vercel manda `Authorization: Bearer ${CRON_SECRET}` a /api/cron/*.
#     Sin esta var, el endpoint del cron responde 503 (nunca queda abierto). ---
CRON_SECRET=

# --- Gemini (IA opcional para análisis de experimentos) ---
GEMINI_API_KEY=

# --- Solo desarrollo local: saltea el login de Supabase para ver la tool en localhost.
#     NO setear en producción (en prod el login queda activo). ---
NEXT_PUBLIC_DEV_BYPASS_AUTH=true

# --- HubSpot — Private App token. SOLO LECTURA. Server-side. ---
HUBSPOT_TOKEN=

# --- Mixpanel — Service Account. SOLO LECTURA. Habilita datos en vivo. Server-side. ---
MIXPANEL_SERVICE_USER=
MIXPANEL_SERVICE_SECRET=
